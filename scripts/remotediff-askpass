#!/bin/bash
# SSH_ASKPASS helper for RemoteDiff
# Shows a native macOS dialog to collect SSH passwords/passphrases.
# SSH passes the prompt (e.g. "Password:" or "Enter passphrase for key...") as $1.
# The prompt is handed to osascript as an argument (not interpolated into the
# script source) so a server-controlled prompt can't inject AppleScript.
# SSH_ASKPASS_PROMPT selects the dialog: "confirm" = yes/no question,
# "none" = notification only (e.g. FIDO touch), otherwise a hidden-answer text field.
# "tell me to activate" brings the dialog to the front so it takes keyboard focus
# even when launched by a background process (the app), without needing Apple
# Events permission for another app.
# Every dialog is tied to the ssh that asked: if ssh exits first (e.g. the app killed it),
# a watchdog kills the dialog, so it never stays on screen over the next prompt.

PROMPT="${1:-SSH Password:}"
SSH_PID=$PPID

# Never answer host-key questions ("Are you sure you want to continue connecting",
# "Accept updated hostkeys?"). RemoteDiff passes StrictHostKeyChecking=yes, but a
# ProxyJump/ProxyCommand hop runs its own ssh without our options and could still ask.
# Exiting non-zero makes ssh treat it as "no".
case "$PROMPT" in
    *"continue connecting"*|*"Accept updated hostkeys"*) exit 1 ;;
esac

# Runs osascript (script on stdin) and kills it if ssh exits first, so a dialog never outlives its ssh.
# The explicit <&0 matters: a non-interactive bash redirects a background job's stdin to /dev/null otherwise.
# The watchdog's output goes to /dev/null so $(...) doesn't wait for it.
run_dialog() {
    local osa= watch=
    # ssh closes a "none" notification by sending SIGTERM to this script: pass it on to the dialog.
    # Installed before the children start, and copes with variables that are still empty.
    trap '[ -n "$osa" ] && kill "$osa" 2>/dev/null; [ -n "$watch" ] && kill "$watch" 2>/dev/null; exit 1' TERM INT HUP
    /usr/bin/osascript - "$PROMPT" <&0 2>/dev/null &
    osa=$!
    ( while kill -0 "$SSH_PID" 2>/dev/null; do sleep 1; done; kill "$osa" 2>/dev/null ) >/dev/null 2>&1 &
    watch=$!
    wait "$osa"
    local status=$?
    kill "$watch" 2>/dev/null
    return $status
}

case "${SSH_ASKPASS_PROMPT:-}" in
    confirm)
        RESULT=$(run_dialog <<'EOF'
on run argv
    tell me to activate
    display dialog (item 1 of argv) with title "RemoteDiff — SSH Authentication" buttons {"No", "Yes"} cancel button "No" with icon caution
    return "yes"
end run
EOF
)
        STATUS=$?
        ;;
    none)
        run_dialog >/dev/null <<'EOF'
on run argv
    tell me to activate
    display dialog (item 1 of argv) with title "RemoteDiff — SSH Authentication" buttons {"OK"} default button "OK" with icon note
    return ""
end run
EOF
        exit 0
        ;;
    *)
        RESULT=$(run_dialog <<'EOF'
on run argv
    tell me to activate
    display dialog (item 1 of argv) default answer "" with hidden answer with title "RemoteDiff — SSH Authentication" buttons {"Cancel", "OK"} default button "OK" with icon caution
    return text returned of result
end run
EOF
)
        STATUS=$?
        ;;
esac

if [ $STATUS -ne 0 ]; then
    # Cancelled, or osascript failed (e.g. invalid UTF-8 prompt) — fail closed
    exit 1
fi

printf '%s\n' "$RESULT"
